# Copy to .env and adjust. Loaded by docker compose; export manually for local runs.

# MLflow: local SQLite store (sqlite:///mlflow.db) by default, or the docker compose server
MLFLOW_TRACKING_URI=http://localhost:5000

# Model served by the API (registered model name + alias)
MODEL_URI=models:/fraud-detection@champion
# Unset = the cost-optimal threshold stored with the model. Set only to override it.
# FRAUD_THRESHOLD=0.5

# Optional alternative to ~/.kaggle/access_token (used in CI)
# KAGGLE_API_TOKEN=
